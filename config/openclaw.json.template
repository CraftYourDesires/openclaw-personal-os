{
  "secrets": {
    "providers": {
      "default": {
        "source": "env"
      }
    },
    "defaults": {
      "env": "default"
    }
  },
  "agents": {
    "defaults": {
      "workspace": "__RUNTIME_ROOT__/workspace",
      "maxConcurrent": 2,
      "subagents": {
        "maxConcurrent": 4
      },
      "model": {
        "primary": "openai/gpt-5.6-sol"
      },
      "models": {
        "openai/gpt-5.6-sol": {
          "agentRuntime": {
            "id": "codex"
          }
        }
      }
    },
    "list": [
      {
        "id": "main",
        "identity": {
          "name": "Remm Personal OS",
          "theme": "Clear, calm personal command center",
          "emoji": ""
        }
      }
    ]
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto",
    "restart": true,
    "ownerDisplay": "raw",
    "ownerAllowFrom": [
      "telegram:${TELEGRAM_USER_ID}"
    ]
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": {
        "source": "env",
        "provider": "default",
        "id": "TELEGRAM_BOT_TOKEN"
      },
      "dmPolicy": "allowlist",
      "allowFrom": [
        "${TELEGRAM_USER_ID}"
      ],
      "groupPolicy": "disabled",
      "execApprovals": {
        "target": "dm"
      },
      "streaming": {
        "mode": "partial",
        "preview": {
          "toolProgress": true,
          "commandText": "status"
        }
      }
    }
  },
  "gateway": {
    "port": 18789,
    "mode": "local",
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": {
        "source": "env",
        "provider": "default",
        "id": "OPENCLAW_GATEWAY_TOKEN"
      }
    },
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    }
  },
  "tools": {
    "exec": {
      "security": "allowlist",
      "ask": "on-miss"
    }
  },
  "plugins": {
    "entries": {
      "telegram": {
        "enabled": true
      },
      "codex": {
        "enabled": true,
        "config": {
          "codexDynamicToolsLoading": "searchable",
          "appServer": {
            "mode": "guardian",
            "approvalPolicy": "on-request",
            "sandbox": "workspace-write",
            "approvalsReviewer": "user"
          }
        }
      },
      "openai": {
        "enabled": true
      },
      "memory-core": {
        "enabled": true
      }
    },
    "allow": [
      "telegram",
      "codex",
      "openai",
      "memory-core"
    ],
    "bundledDiscovery": "compat"
  },
  "skills": {
    "install": {
      "nodeManager": "npm"
    }
  }
}
